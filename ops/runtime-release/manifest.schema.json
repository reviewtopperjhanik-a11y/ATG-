{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agt.invalid/schemas/runtime-manifest-v1.schema.json",
  "title": "AGT Linux Runtime Manifest",
  "description": "Schema enforced by com.example.data.runtime.RuntimeManifestParser for Android ARM64/multi-ABI PRoot rootfs installation.",
  "type": "object",
  "required": [
    "runtime_id",
    "version",
    "release_channel",
    "supported_abis",
    "min_android_sdk",
    "min_required_free_bytes",
    "bundles",
    "components",
    "license_notices"
  ],
  "additionalProperties": true,
  "properties": {
    "manifest_schema_version": {
      "type": "integer",
      "const": 1
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "release_channel": {
      "type": "string",
      "enum": ["stable", "beta", "canary", "dev"]
    },
    "supported_abis": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "const": "arm64-v8a"
      },
      "items": {
        "type": "string",
        "enum": ["arm64-v8a", "x86_64", "armeabi-v7a"]
      }
    },
    "min_android_sdk": {
      "type": "integer",
      "minimum": 24,
      "maximum": 100
    },
    "min_required_free_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "bundles": {
      "type": "object",
      "required": ["arm64-v8a"],
      "additionalProperties": {
        "$ref": "#/$defs/bundleSpec"
      }
    },
    "bundle": {
      "$ref": "#/$defs/bundleSpec"
    },
    "components": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/componentSpec"
      }
    },
    "license_notices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/licenseNotice"
      }
    }
  },
  "$defs": {
    "bundleSpec": {
      "type": "object",
      "required": [
        "download_url",
        "compressed_size_bytes",
        "sha256",
        "archive_format",
        "extraction_root",
        "required_paths"
      ],
      "additionalProperties": false,
      "properties": {
        "download_url": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "compressed_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_format": {
          "type": "string",
          "enum": ["tar.gz", "tgz", "tar", "zip"]
        },
        "extraction_root": {
          "type": "string"
        },
        "required_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "componentSpec": {
      "type": "object",
      "required": ["id", "name", "description", "version", "required_paths", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "linux_runtime",
            "base_toolchains",
            "opencode_agent",
            "github_cli",
            "base_skills_mcp"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "required_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "licenseNotice": {
      "type": "object",
      "required": ["component", "license", "spdx_id", "summary"],
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "spdx_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
